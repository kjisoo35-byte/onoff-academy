name = "onoff-academy"
pages_build_output_dir = "."
compatibility_date = "2026-08-08"

[[env.preview.d1_databases]]
binding = "DB"
database_name = "onoff-academy-staging"
database_id = "REPLACE_WITH_APPROVED_STAGING_D1_ID"
migrations_dir = "migrations"

[env.preview.vars]
WORK_ACADEMY_LOGIN_URL = "https://onoff-work.pages.dev/api/academy/assertion"

# WORK_ACADEMY_ASSERTION_SECRET must be configured as a Preview secret.
# Do not place a real secret in this file.
